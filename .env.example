# ── App ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ── Database ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=autoparts
# В dev можно true, в проде — только миграции
DB_SYNC=false
DB_LOGGING=false

# ── Auth ────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# В dev код OTP возвращается в ответе и пишется в лог. В проде — false!
OTP_DEV_MODE=true
OTP_SECRET=change-me-otp

# ── Files (local или s3) ────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ── Integrations (опционально) ──────────────────
TELEGRAM_BOT_TOKEN=
VIN_DECODER_EXTERNAL=true
# mock — тестовые оплаты (dev), manual — подтверждение админом
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook

# ── Bootstrap admin (используется в seed) ───────
ADMIN_PHONE=+996700000000
